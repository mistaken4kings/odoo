<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_mazuri_financing_tree" model="ir.ui.view">
    <field name="name">mazuri.financing.tree</field>
    <field name="model">mazuri.financing</field>
    <field name="arch" type="xml">
      <list decoration-success="state == 'repaid'"
            decoration-info="state in ('accepted', 'disbursed')"
            decoration-danger="state == 'overdue'"
            decoration-muted="state == 'declined'">
        <field name="name"/>
        <field name="retailer_name"/>
        <field name="sale_order_id" optional="show"/>
        <field name="principal"/>
        <field name="payout_speed" optional="show"/>
        <field name="payout_fee" optional="hide"/>
        <field name="payout_total"/>
        <field name="disbursed_at" optional="show"/>
        <field name="due_date"/>
        <field name="state" widget="badge"
               decoration-success="state == 'repaid'"
               decoration-info="state in ('accepted', 'disbursed')"
               decoration-danger="state == 'overdue'"/>
        <field name="currency_id" column_invisible="1"/>
      </list>
    </field>
  </record>

  <record id="view_mazuri_financing_form" model="ir.ui.view">
    <field name="name">mazuri.financing.form</field>
    <field name="model">mazuri.financing</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <div class="oe_title">
            <h1><field name="name" readonly="1"/></h1>
          </div>
          <group>
            <group string="Order">
              <field name="retailer_name"/>
              <field name="retailer_phone"/>
              <field name="sale_order_id"/>
              <field name="org_id"/>
            </group>
            <group string="Financing">
              <field name="currency_id" invisible="1"/>
              <field name="principal"/>
              <field name="payout_speed"/>
              <field name="payout_fee"/>
              <field name="payout_total"/>
              <field name="disbursed_at"/>
              <field name="due_date"/>
              <field name="state"/>
            </group>
          </group>
          <group string="Notes">
            <field name="notes" nolabel="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_mazuri_financing" model="ir.actions.act_window">
    <field name="name">Mazuri Financing</field>
    <field name="res_model">mazuri.financing</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">No financed orders yet</p>
      <p>Retailer orders financed by Mazuri (Pay in 30, interest free) appear
      here automatically once your instance is connected.</p>
    </field>
  </record>
</odoo>
