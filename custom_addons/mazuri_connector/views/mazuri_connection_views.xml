<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_mazuri_connection_tree" model="ir.ui.view">
    <field name="name">mazuri.connection.tree</field>
    <field name="model">mazuri.connection</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="org_id"/>
        <field name="org_name"/>
        <field name="api_login"/>
        <field name="connected_at"/>
        <field name="connected_by_id"/>
        <field name="active"/>
      </list>
    </field>
  </record>

  <record id="view_mazuri_connection_form" model="ir.ui.view">
    <field name="name">mazuri.connection.form</field>
    <field name="model">mazuri.connection</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="org_id"/>
            <field name="org_name"/>
            <field name="api_user_id"/>
            <field name="api_login"/>
            <field name="connected_by_id"/>
            <field name="connected_at"/>
            <field name="last_sync_at"/>
            <field name="active"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_mazuri_connections" model="ir.actions.act_window">
    <field name="name">Mazuri Connections</field>
    <field name="res_model">mazuri.connection</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
